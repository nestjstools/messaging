{
  "name": "@nestjstools/messaging-amazon-sqs-extension",
  "version": "2.3.0",
  "type": "module",
  "description": "Extension to handle messages and dispatch them over Amazon SQS",
  "author": "Sebastian Iwanczyszyn",
  "license": "MIT",
  "main": "lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/nestjstools/messaging/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestjstools/messaging",
    "directory": "packages/messaging-amazon-sqs-extension"
  },
  "keywords": [
    "nestjs",
    "nestjstools",
    "nestjstools messaging",
    "amazon sqs",
    "nestjs sqs",
    "message bus",
    "event driven",
    "aws"
  ],
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "nest build",
    "prettier:fix": "prettier --write \"src/**/*.ts\"",
    "prettier": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint .",
    "ci": "yarn prettier",
    "test": "vitest run --passWithNoTests",
