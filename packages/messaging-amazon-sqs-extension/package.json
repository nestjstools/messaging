    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1118.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.x || ^11.x || ^12.x",
    "@nestjs/core": "^10.x || ^11.x || ^12.x",
    "@nestjstools/messaging": "^5.x",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.x"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@nestjstools/messaging": "^5.0.0",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11",
    "webpack": "^5.105.2"
  },
  "homepage": "https://docs.nestjstools.com/messaging"
