{
  "name": "@nestjstools/messaging",
  "version": "4.5.0",
  "type": "module",
  "description": "Simplifies asynchronous and synchronous message handling with support for buses, handlers, channels, and consumers. Build scalable, decoupled applications with ease and reliability.",
  "author": "Sebastian Iwanczyszyn",
  "license": "MIT",
  "main": "lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://docs.nestjstools.com/messaging",
  "bugs": {
    "url": "https://github.com/nestjstools/messaging/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestjstools/messaging",
    "directory": "packages/messaging"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "nestjs",
    "nestjs messaging",
    "nestjs message bus",
    "nestjs service bus",
    "nestjs distributed systems",
    "nestjs microservices",
    "message broker",
    "event driven architecture",
    "microservices architecture"
  ],
  "scripts": {
    "build": "nest build",
    "prettier:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prettier": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint .",
    "test": "npm run test:e2e && npm run test:unit",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "class-transformer": "^0.5.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.x || ^11.x || ^12.x",
    "@nestjs/core": "^10.x || ^11.x || ^12.x",
    "reflect-metadata": "^0.2.x",
    "rxjs": "^7.x"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1"
  }
}
